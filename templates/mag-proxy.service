[Unit]
Description=mag proxy server - see mag/proxy/proxy.py
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mag
Group=mag
WorkingDirectory=__MAG_HOME__
EnvironmentFile=__MAG_HOME__/.env
# Allows `from mag.lib import ...` to resolve without an install step.
# The mag wrapper (see setup.sh) does the same for `mag` commands.
Environment=PYTHONPATH=__MAG_HOME__
UMask=0007
ExecStart=/usr/bin/python3 __MAG_HOME__/mag/proxy/proxy.py
Restart=on-failure
RestartSec=5

# Hardening. Binds to 127.0.0.1 only (see mag/proxy/proxy.py) - nginx is the
# sole internet-facing front door, proxying /proxy/ to this port.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ProtectHome hides /home, /root and /run/user outright, regardless of file
# permissions - so if this checkout lives under /home (setup.sh promises
# "clone it anywhere"), WorkingDirectory itself would be invisible to the
# unit and fail to start with "Changing to the requested working directory
# failed: Permission denied". Explicitly re-exposing __MAG_HOME__ read-only
# covers that case without weakening ProtectHome for the rest of /home.
ReadOnlyPaths=__MAG_HOME__
# Needs write access for tokens.json (refreshed access tokens),
# mag_tokens.json (last_used_at bumps) and proxy_audit.log, all under
# var/ (see mag/lib/paths.py) - scoped to just that, not the whole
# checkout, so a compromised or buggy proxy process can't touch its own
# source. setup.sh creates var/ up front so it exists before this unit
# ever starts (ReadWritePaths on a not-yet-existing path is fragile).
# ReadWritePaths always wins over the ReadOnlyPaths above for this nested
# path, regardless of declaration order.
ReadWritePaths=__MAG_HOME__/var

[Install]
WantedBy=multi-user.target
