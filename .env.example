# Copy to .env at the repo root (gitignored - never commit the real file).
# setup.sh also creates/completes this interactively if it's missing, so
# hand-editing this is optional.

MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
# Domain this server is reachable at - used for the OAuth redirect URI
# and the nginx server_name/cert paths.
MAG_DOMAIN=

# Optional overrides - uncomment if needed:
#MAG_PROXY_PORT=8788
#MYOB_CF_USERNAME=
#MYOB_CF_PASSWORD=
